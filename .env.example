NODE_ENV=development
PORT=3000
SITE_ORIGIN=http://localhost:3000
DATABASE_URL=mysql://user:password@localhost:3306/trueaxis
JWT_SECRET=replace-with-a-long-random-secret

# Docker Compose database credentials (use strong unique values).
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Local uploads are stored under UPLOAD_DIR and served at /uploads.
UPLOAD_DIR=uploads

# SMTP is used for password resets and owner notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
OWNER_EMAIL=
# Optional authenticated scheduler secret for POST /api/scheduled/dailyDigest.
DIGEST_CRON_SECRET=

# OpenAI-compatible AI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional Google Maps integrations.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional explicitly configured external data API.
DATA_API_BASE_URL=
DATA_API_KEY=

# Optional Stripe billing and webhook processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Google Calendar OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional frontend/runtime branding overrides.
VITE_SITE_URL=
VITE_APP_TITLE=TrueAxis HQ
VITE_APP_LOGO=
