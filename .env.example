# TrueAxis HQ — environment template
# Copy to .env and fill in real values. Never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────
# MySQL connection string (mysql://user:pass@host:3306/dbname)
DATABASE_URL=

# Session token signing secret. REQUIRED in production — the server refuses to
# boot without it. Use: openssl rand -hex 32
JWT_SECRET=

# ── Core ─────────────────────────────────────────────────────────────────────
# Comma-separated "name=value" list of accounts to bootstrap as admins
ADMIN_EMAILS=

# Public origin used in emails/links (defaults to https://trueaxishq.com)
SITE_ORIGIN=
VITE_SITE_URL=https://trueaxishq.com

# Node environment (development | production) and HTTP port
NODE_ENV=production
PORT=3000

# ── Email (SMTP) — optional; email features degrade gracefully when unset ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Stripe — optional; invoicing/checkout degrades gracefully when unset ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google Calendar — optional; enables the calendar integration ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Scheduled job hardening ─────────────────────────────────────────────────
# Shared secret required by the POST /api/scheduled/dailyDigest cron hook
DIGEST_CRON_SECRET=

# ── Optional platform integrations ───────────────────────────────────────────
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_APP_TITLE=TrueAxis HQ
VITE_APP_LOGO=
