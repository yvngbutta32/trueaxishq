NODE_ENV=development
PORT=3000
SITE_ORIGIN=http://localhost:3000
DATABASE_URL=mysql://user:password@localhost:3306/trueaxis
JWT_SECRET=replace-with-a-long-random-secret

# Local uploads are stored under UPLOAD_DIR and served at /uploads.
UPLOAD_DIR=uploads

# SMTP is used for password resets and owner notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
OWNER_EMAIL=

# OpenAI-compatible AI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional Google Maps integrations.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional explicitly configured external data API.
DATA_API_BASE_URL=
DATA_API_KEY=
